# =====================================================================
# Modèle des réglages de production. Sur le serveur :
#     cp .env.prod.example .env.prod   puis remplir les valeurs (jamais dans git)
# =====================================================================

# Adresse du site. En ligne : le nom de domaine (Caddy obtient le certificat HTTPS tout seul).
# Pour un essai sur ton PC : ORIVY_SITE=:80
ORIVY_SITE=orivy.fr
ORIVY_CORS_ORIGINES=https://orivy.fr

# Mot de passe de la base (lettres et chiffres, 24 caractères ou plus)
ORIVY_DB_PASSWORD=

# Clé des jetons de connexion : 32 octets en base64, DIFFÉRENTE de celle du dev.
# La générer avec :  openssl rand -base64 32
ORIVY_JWT_SECRET=

# Compte administrateur créé au premier démarrage
ORIVY_ADMIN_EMAIL=
ORIVY_ADMIN_MOT_DE_PASSE=

# Ports publiés (80 et 443 en ligne ; d'autres pour un essai si 80/443 sont pris)
ORIVY_PORT_HTTP=80
ORIVY_PORT_HTTPS=443

# ---------------------------------------------------------------------
# Mise en ligne GRATUITE via tunnel ngrok (voir docker-compose.tunnel.yml).
# Compte gratuit sur ngrok.com, puis :
#   - Your Authtoken  -> NGROK_AUTHTOKEN
#   - Domains (1 domaine statique gratuit) -> SITE_DOMAIN
# En mode tunnel, mets aussi ORIVY_SITE=:80 et ORIVY_CORS_ORIGINES=https://<SITE_DOMAIN>.
# ---------------------------------------------------------------------
NGROK_AUTHTOKEN=
SITE_DOMAIN=mon-orivy.ngrok-free.app

# Import OpenStreetMap automatique (démarrage + chaque mois). false = seulement via le bouton admin
ORIVY_OSM_IMPORT_AUTO=true
